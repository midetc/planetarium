        <mxCell id="e-user-reservation" value="1        n" style="endArrow=block;html=1;strokeWidth=1;" edge="1" parent="1" source="user" target="reservation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
